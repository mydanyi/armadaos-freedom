--- /dev/null
+++ b/src/msm_metrics.h
@@ -0,0 +1,82 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <regex>
+#include <string>
+#include <vector>
+
+namespace msm_metrics {
+
+class BusyRatio {
+    uint64_t previous_busy = 0;
+    uint64_t previous_time = 0;
+    bool initialized = false;
+public:
+    void reset() { initialized = false; }
+
+    int sample(uint64_t busy_ns, uint64_t time_ns)
+    {
+        int result = -1;
+        if (initialized && busy_ns >= previous_busy && time_ns > previous_time) {
+            const double percent = 100.0 * (busy_ns - previous_busy) /
+                                   (time_ns - previous_time);
+            result = static_cast<int>(std::lround(std::clamp(percent, 0.0, 100.0)));
+        }
+        previous_busy = busy_ns;
+        previous_time = time_ns;
+        initialized = true;
+        return result;
+    }
+};
+
+class Temperatures {
+    std::vector<std::ifstream> streams;
+public:
+    explicit Temperatures(const std::string& root = "/sys/class/hwmon")
+    {
+        namespace fs = std::filesystem;
+        std::error_code error;
+        const std::regex gpu_name("gpuss_[0-9]+_thermal|gpu_thermal|gpu");
+        const std::regex temperature_file("temp[0-9]+_input");
+        for (fs::directory_iterator it(root, error), end; !error && it != end; it.increment(error)) {
+            std::ifstream name_file(it->path() / "name");
+            std::string name;
+            if (!(name_file >> name) || !std::regex_match(name, gpu_name))
+                continue;
+            std::error_code sensor_error;
+            for (fs::directory_iterator sensor(it->path(), sensor_error), last;
+                 !sensor_error && sensor != last; sensor.increment(sensor_error)) {
+                if (!std::regex_match(sensor->path().filename().string(), temperature_file))
+                    continue;
+                std::ifstream input(sensor->path());
+                if (input.is_open())
+                    streams.push_back(std::move(input));
+            }
+        }
+    }
+
+    size_t size() const { return streams.size(); }
+
+    int maximum()
+    {
+        bool valid = false;
+        int maximum_millidegrees = 0;
+        for (auto& stream : streams) {
+            stream.clear();
+            stream.seekg(0);
+            int millidegrees;
+            if (!(stream >> millidegrees))
+                continue;
+            if (!valid || millidegrees > maximum_millidegrees)
+                maximum_millidegrees = millidegrees;
+            valid = true;
+        }
+        return valid ? maximum_millidegrees / 1000 : -1;
+    }
+};
+
+}
