+static int dpu_plane_check_qseed3_v11(struct dpu_sw_pipe *pipe,
+		struct dpu_sw_pipe_cfg *cfg,
+		struct drm_plane_state *state,
+		const struct msm_format *fmt)
+{
+	const struct dpu_sspp_sub_blks *sblk = pipe->sspp->cap->sblk;
+	struct drm_rect full_src, post_src, full_dst, post_dst, ext;
+	int ret;
+
+	cfg->qseed3_v11_valid = false;
+
+	/* Catalog version 3.5 identifies QSEED V11. */
+	if (sblk->scaler_blk.version != 0x30005) {
+		/*
+		 * Elden (Y700 Gen4 TB322FC) stock library uses the
+		 * QSEED 3.4 native sampling path; allow only that board.
+		 */
+		if (sblk->scaler_blk.version != 0x30004 ||
+		    !of_machine_is_compatible("lenovo,elden"))
+			return 0;
+	}
+	if (MSM_FORMAT_IS_YUV(fmt))
+		return 0;
+	if (!(cfg->rotation & DRM_MODE_ROTATE_90))
+		return 0;
+
+	drm_rect_fp_to_int(&full_src, &state->src);
+	post_src = cfg->src_rect;
+	drm_rect_rotate(&full_src, state->fb->width, state->fb->height,
+			state->rotation);
+	drm_rect_rotate(&post_src, state->fb->width, state->fb->height,
+			state->rotation);
+
+	post_dst = cfg->dst_rect;
+	post_dst.x1 += cfg->mixer_x;
+	post_dst.x2 += cfg->mixer_x;
+	full_dst = state->dst;
+
+	ret = dpu_qseed3_v11_axis(drm_rect_width(&full_src), drm_rect_width(&full_dst),
+				  post_src.x1 - full_src.x1, drm_rect_width(&post_src),
+				  post_dst.x1 - full_dst.x1, drm_rect_width(&post_dst),
+				  5, 12, &cfg->qseed3_v11[0]);
+	if (ret)
+		return ret;
+
+	ret = dpu_qseed3_v11_axis(drm_rect_height(&full_src), drm_rect_height(&full_dst),
+				  post_src.y1 - full_src.y1, drm_rect_height(&post_src),
+				  post_dst.y1 - full_dst.y1, drm_rect_height(&post_dst),
+				  1, 4, &cfg->qseed3_v11[1]);
+	if (ret)
+		return ret;
+
+	ext = post_src;
+	ext.x1 -= cfg->qseed3_v11[0].fetch_before;
+	ext.x2 += cfg->qseed3_v11[0].fetch_after;
+	ext.y1 -= cfg->qseed3_v11[1].fetch_before;
+	ext.y2 += cfg->qseed3_v11[1].fetch_after;
+
+	drm_rect_rotate_inv(&ext, state->fb->width, state->fb->height,
+			    state->rotation);
+
+	if (drm_rect_height(&ext) > sblk->rotation_cfg->rot_maxheight)
+		return -ERANGE;
+
+	if (ext.x1 < 0 || ext.y1 < 0 ||
+	    ext.x2 > state->fb->width || ext.y2 > state->fb->height)
+		return -ERANGE;
+
+	if (drm_rect_width(&ext) <= 0 || drm_rect_height(&ext) <= 0)
+		return -ERANGE;
+
+	cfg->src_ext_rect = ext;
+	cfg->qseed3_v11_valid = true;
+
+	return 0;
+}
