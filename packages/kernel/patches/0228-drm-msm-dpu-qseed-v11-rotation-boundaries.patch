 	struct drm_rect src_rect;
 	struct drm_rect dst_rect;
 	unsigned int rotation;
+	int mixer_x;
+	bool qseed3_v11_valid;
+	struct dpu_qseed3_axis qseed3_v11[2];
+	struct drm_rect src_ext_rect;
 };
 
