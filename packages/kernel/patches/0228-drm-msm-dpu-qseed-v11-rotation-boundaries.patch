+static void dpu_plane_setup_qseed3_v11(struct dpu_sw_pipe_cfg *pipe_cfg,
+				       struct dpu_hw_scaler3_cfg *scale_cfg,
+				       struct dpu_hw_pixel_ext *pixel_ext)
+{
+	const struct dpu_qseed3_axis *ax = &pipe_cfg->qseed3_v11[0];
+	const struct dpu_qseed3_axis *ay = &pipe_cfg->qseed3_v11[1];
+	const struct drm_rect *src = &pipe_cfg->src_rect;
+	const struct drm_rect *ext = &pipe_cfg->src_ext_rect;
+	int fetch_left, fetch_right, fetch_top, fetch_btm;
+	int i;
+
+	for (i = 0; i < DPU_MAX_PLANES; i++) {
+		scale_cfg->phase_step_x[i] = ax->phase_step;
+		scale_cfg->phase_step_y[i] = ay->phase_step;
+		scale_cfg->init_phase_x[i] = ax->init_phase;
+		scale_cfg->init_phase_y[i] = ay->init_phase;
+		scale_cfg->preload_x[i] = ax->preload;
+		scale_cfg->preload_y[i] = ay->preload;
+		scale_cfg->src_width[i] = ax->src_size;
+		scale_cfg->src_height[i] = ay->src_size;
+		scale_cfg->enable = 1;
+	}
+
+	fetch_left = src->x1 - ext->x1;
+	fetch_right = ext->x2 - src->x2;
+	fetch_top = src->y1 - ext->y1;
+	fetch_btm = ext->y2 - src->y2;
+
+	for (i = 0; i < DPU_MAX_PLANES; i++) {
+		pixel_ext->left_ftch[i] = fetch_left;
+		pixel_ext->right_ftch[i] = fetch_right;
+		pixel_ext->top_ftch[i] = fetch_top;
+		pixel_ext->btm_ftch[i] = fetch_btm;
+
+		pixel_ext->num_ext_pxls_left[i] = fetch_left;
+		pixel_ext->num_ext_pxls_right[i] = fetch_right;
+		pixel_ext->num_ext_pxls_top[i] = fetch_top;
+		pixel_ext->num_ext_pxls_btm[i] = fetch_btm;
+
+		pixel_ext->left_rpt[i] = 0;
+		pixel_ext->right_rpt[i] = 0;
+		pixel_ext->top_rpt[i] = 0;
+		pixel_ext->btm_rpt[i] = 0;
+
+		pixel_ext->roi_w[i] = drm_rect_width(src);
+		pixel_ext->roi_h[i] = drm_rect_height(src);
+	}
+
+	pixel_ext->enable_pxl_ext = 1;
+}
