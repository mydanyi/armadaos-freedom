@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef DPU_HW_QSEED3_V11_H
+#define DPU_HW_QSEED3_V11_H
+
+#include <linux/types.h>
+#include <linux/math64.h>
+#include <linux/errno.h>
+
+struct dpu_qseed3_axis {
+	u32 phase_step;
+	u32 init_phase;
+	u32 preload;
+	u32 src_size;
+	s32 fetch_before;
+	s32 fetch_after;
+};
+
+static inline s64 dpu_qseed3_min64(s64 a, s64 b)
+{
+	return a < b ? a : b;
+}
+
+/*
+ * QSEED V11 scaling constraints:
+ * - RGB without predownscale.
+ * - Phase steps and initial phases use Q21; geometry inputs are pixels.
+ * - Whole-plane ratio and offset make adjacent pipes share sampling grid.
+ * - Support/base preload V11X5/12, Y1/4.
+ * - Negative fetch means cropping; missing outer pixels are handled by
+ *   dynamic extension with preload, not explicit repeat.
+ * Not a claim for all formats or verified hardware.
+ */
+static inline int dpu_qseed3_v11_axis(u32 full_src, u32 full_dst,
+				      u32 src_start, u32 src_len,
+				      u32 dst_start, u32 dst_len,
+				      u32 support, u32 base_preload,
+				      struct dpu_qseed3_axis *out)
+{
+	s64 step, raw, requestedbefore, requestedafter, delta;
+	s64 remaining, wanted, before, after, total, preload;
+
+	if (!full_src || !full_dst || !src_len || !dst_len)
+		return -EINVAL;
+	if (full_src > 65535 || full_dst > 65535)
+		return -EINVAL;
+	if (src_start > full_src || src_len > full_src - src_start)
+		return -EINVAL;
+	if (dst_start > full_dst || dst_len > full_dst - dst_start)
+		return -EINVAL;
+	if (support > 12)
+		return -EINVAL;
+
+	step = (s64)div_u64((u64)full_src << 21, full_dst);
+	if (step == 0 || step > 0xffffffffLL)
+		return -ERANGE;
+
+	raw = ((s64)step - (1 << 21)) >> 1;
+	raw += 16384 + (s64)dst_start * step - ((s64)src_start << 21);
+
+	requestedbefore = (s64)support - (raw >> 21);
+
+	delta = raw + (s64)(dst_len - 1) * step - ((s64)(src_len - 1) << 21);
+	requestedafter = (s64)support + 1 + (delta >> 21);
+
+	remaining = (s64)full_src - src_start - src_len;
+	wanted = (s64)src_len + requestedbefore + requestedafter;
+	if (wanted < 1)
+		wanted = 1;
+
+	if (requestedbefore >= 0 && requestedafter >= 0) {
+		before = dpu_qseed3_min64(requestedbefore, (s64)src_start);
+		after = dpu_qseed3_min64(requestedafter, remaining);
+	} else if (requestedbefore < 0 && requestedafter >= 0) {
+		before = -dpu_qseed3_min64(-requestedbefore, (s64)src_len - 1);
+		after = dpu_qseed3_min64(requestedafter, remaining);
+		after = dpu_qseed3_min64(after, wanted - 1);
+	} else if (requestedbefore >= 0 && requestedafter < 0) {
+		before = dpu_qseed3_min64(requestedbefore, (s64)src_start);
+		before = dpu_qseed3_min64(before, wanted - 1);
+		after = -dpu_qseed3_min64(-requestedafter, (s64)src_len - 1);
+	} else {
+		before = -dpu_qseed3_min64(-requestedbefore, (s64)src_len - 1);
+		after = -dpu_qseed3_min64(-requestedafter,
+					(s64)src_len + before - 1);
+	}
+
+	total = (s64)src_len + before + after;
+	preload = (s64)base_preload + before - requestedbefore;
+
+	if (total <= 0 || total > 65535)
+		return -ERANGE;
+	if (preload < 0 || preload > 127)
+		return -ERANGE;
+	if (before < -128 || before > 127)
+		return -ERANGE;
+	if (after < -128 || after > 127)
+		return -ERANGE;
+
+	out->phase_step = (u32)step;
+	out->init_phase = (u32)raw & ((1 << 21) - 1);
+	out->preload = (u32)preload;
+	out->src_size = (u32)total;
+	out->fetch_before = (s32)before;
+	out->fetch_after = (s32)after;
+
+	return 0;
+}
+
+#endif
