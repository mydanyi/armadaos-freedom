+/* The caller holds df->lock and the GPU has not been suspended. */
+static void msm_devfreq_monitor_update(struct msm_gpu *gpu)
+{
+	struct msm_gpu_devfreq *df = &gpu->devfreq;
+	unsigned long sample_rate;
+	u64 cycles;
+
+	cycles = gpu->funcs->gpu_busy(gpu, &sample_rate);
+	if (sample_rate && cycles >= df->monitor_busy_cycles)
+		df->monitor_busy_ns += mul_u64_u64_div_u64(
+			cycles - df->monitor_busy_cycles, NSEC_PER_SEC, sample_rate);
+	df->monitor_busy_cycles = cycles;
+}
+
+static ssize_t gpu_busy_time_ns_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct msm_gpu *gpu = dev_to_gpu(dev);
+	struct msm_gpu_devfreq *df = &gpu->devfreq;
+	unsigned long sample_rate;
+	u64 busy_ns;
+	int active;
+
+	/* Hold a runtime PM reference without waking an idle GPU. */
+	active = pm_runtime_get_if_active(dev);
+	mutex_lock(&df->lock);
+	if (!df->monitor_enabled) {
+		df->monitor_enabled = true;
+		if (active > 0 && !df->suspended)
+			df->monitor_busy_cycles = gpu->funcs->gpu_busy(gpu,
+							   &sample_rate);
+	} else if (active > 0 && !df->suspended) {
+		msm_devfreq_monitor_update(gpu);
+	}
+	busy_ns = df->monitor_busy_ns;
+	mutex_unlock(&df->lock);
+	if (active > 0)
+		__pm_runtime_put_autosuspend(dev);
+
+	return sysfs_emit(buf, "%llu\n", busy_ns);
+}
+static DEVICE_ATTR_RO(gpu_busy_time_ns);
+
