From: "lich.wang" <lich.wang@gmail.com>
Date: Fri, 23 Oct 2026 06:07:21 +0000
Subject: [PATCH] ASoC: qcom: sc8280xp: add the Lenovo TB710FU card

Four Awinic AW882xx amplifiers on SECONDARY_TDM_RX_0, 4 channels of
32 bit in an 8-slot frame.  On "lenovo,tb710fu-sndcard" the TDM BE links
get 4ch/S32 and the CPU DAI runs DSP_B with an inverted bit clock, slots
from dai-tdm-slot-*; nothing changes for the other cards.
---
 sound/soc/qcom/sc8280xp.c | 53 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index 01244a139..643000662 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -27,6 +27,7 @@ struct sc8280xp_snd_data {
 	bool jack_setup;
 	bool wsa2_only;
 	bool mi2s_s32;
+	bool tdm_speakers;
 };
 
 static int sc8280xp_snd_init(struct snd_soc_pcm_runtime *rtd)
@@ -156,6 +157,15 @@ static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 			snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S32_LE);
 		}
 		break;
+	case PRIMARY_TDM_RX_0 ... QUINARY_TDM_TX_7:
+		/* TB710FU: 4 channels of 32 bit, as in the vendor audio config */
+		if (data->tdm_speakers) {
+			snd_mask_none(fmt);
+			snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S32_LE);
+			channels->min = 4;
+			channels->max = 4;
+		}
+		break;
 	default:
 		break;
 	}
@@ -205,6 +215,45 @@ static int sc8280xp_snd_prepare(struct snd_pcm_substream *substream)
 	return qcom_snd_sdw_prepare(substream, &data->stream_prepared[cpu_dai->id]);
 }
 
+/*
+ * TDM speaker links (TB710FU): the CPU DAI drives bit and frame clock in
+ * DSP_B timing with an inverted bit clock, as the amplifiers' vendor setup
+ * expects; the slots come from the link's dai-tdm-slot-* properties.
+ */
+static int sc8280xp_snd_hw_params(struct snd_pcm_substream *substream,
+				  struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct qcom_snd_tdm_slot_cfg cpu_cfg;
+	struct qcom_snd_tdm_slot_cfg codec_cfg;
+	int ret;
+
+	switch (cpu_dai->id) {
+	case PRIMARY_TDM_RX_0 ... QUINARY_TDM_TX_7:
+		if (!data->tdm_speakers)
+			return 0;
+		break;
+	default:
+		return 0;
+	}
+
+	ret = qcom_snd_get_dai_tdm_slots(rtd, &cpu_cfg, &codec_cfg);
+	if (ret)
+		return ret == -ENOENT ? 0 : ret;
+
+	if (!cpu_cfg.slots)
+		return 0;
+
+	ret = snd_soc_dai_set_fmt(cpu_dai, SND_SOC_DAIFMT_BP_FP |
+				  SND_SOC_DAIFMT_DSP_B | SND_SOC_DAIFMT_IB_NF);
+	if (ret && ret != -ENOTSUPP)
+		return ret;
+
+	return qcom_snd_apply_dai_tdm_slots_cfg(rtd, &cpu_cfg, &codec_cfg);
+}
+
 static int sc8280xp_snd_hw_free(struct snd_pcm_substream *substream)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
@@ -217,6 +266,7 @@ static int sc8280xp_snd_hw_free(struct snd_pcm_substream *substream)
 static const struct snd_soc_ops sc8280xp_be_ops = {
 	.startup = sc8280xp_snd_startup,
 	.shutdown = sc8280xp_snd_shutdown,
+	.hw_params = sc8280xp_snd_hw_params,
 	.hw_free = sc8280xp_snd_hw_free,
 	.prepare = sc8280xp_snd_prepare,
 };
@@ -269,6 +319,8 @@ static int sc8280xp_platform_probe(struct platform_device *pdev)
 						  "ayaneo,pocket-s2-sndcard") ||
 			  of_device_is_compatible(dev->of_node,
 						  "konkr,pocket-fit-sndcard");
+	data->tdm_speakers = of_device_is_compatible(dev->of_node,
+						     "lenovo,tb710fu-sndcard");
 	card->driver_name = of_device_get_match_data(dev);
 	data->mi2s_s32 = of_property_read_bool(dev->of_node, "qcom,mi2s-s32le");
 	sc8280xp_add_be_ops(card);
@@ -278,6 +330,7 @@ static int sc8280xp_platform_probe(struct platform_device *pdev)
 static const struct of_device_id snd_sc8280xp_dt_match[] = {
 	{.compatible = "ayaneo,pocket-s2-sndcard", "ayaneo-ps2"},
 	{.compatible = "konkr,pocket-fit-sndcard", "sm8650"},
+	{.compatible = "lenovo,tb710fu-sndcard", "sm8650"},
 	{.compatible = "qcom,eliza-sndcard", "eliza"},
 	{.compatible = "qcom,kaanapali-sndcard", "kaanapali"},
 	{.compatible = "qcom,qcm6490-idp-sndcard", "qcm6490"},
