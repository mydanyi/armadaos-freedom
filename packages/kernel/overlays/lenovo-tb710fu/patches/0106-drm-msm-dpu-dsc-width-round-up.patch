From: "lich.wang" <lich.wang@gmail.com>
Date: Fri, 23 Oct 2026 06:07:20 +0000
Subject: [PATCH] drm/msm/dpu: round the TB710FU DSC timing width up

Like the DSI host (1600 * 8 / 30 = 426.67 -> 427), so both blocks agree
on the active width of the compressed line.

From MeteoricmeteorLL/tb710fu-linux.
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
index d6c9738b7..b973081b4 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -149,6 +149,15 @@ static void drm_mode_to_intf_timing_params(
 			timing->width =
 				DIV_ROUND_UP(timing->dce_bytes_per_line * 8,
 					     dsc->bits_per_component * 3);
+		} else if (of_machine_is_compatible("lenovo,tb710fu")) {
+			/*
+			 * TB710FU: round the compressed width up like the DSI
+			 * host does (1600 * 8 / 30 = 426.67 -> 427).
+			 */
+			timing->width =
+				DIV_ROUND_UP(timing->width *
+					     drm_dsc_get_bpp_int(dsc),
+					     dsc->bits_per_component * 3);
 		} else if (of_machine_is_compatible("lenovo,baldur") &&
 			   dsc->dsc_version_minor == 2 &&
 			   dsc->bits_per_component > 8) {
