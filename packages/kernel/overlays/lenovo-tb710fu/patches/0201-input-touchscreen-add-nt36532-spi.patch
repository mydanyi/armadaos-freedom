+static const struct proc_ops nvt_get_pen_id_fops = {
+	.proc_open = nvt_get_pen_id_open,
+	.proc_write = nvt_get_pen_id_write,
+	.proc_read = seq_read,
+        .proc_lseek = seq_lseek,
+        .proc_release = single_release,
