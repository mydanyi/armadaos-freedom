+/*******************************************************
+Description:
+	Novatek touchscreen MP function proc. file node
+	deinitial function.
+
+return:
+	n.a.
+*******************************************************/
+void nvt_mp_proc_deinit(void)
+{
+	nvt_mp_buffer_deinit();
+
+	/*
+	 * TB710FU: remove_proc_entry(NVT_SELFTEST, ...) warned with
+	 * "name 'nvt_selftest'" and left /proc/android_touch non-empty, so the
+	 * following remove_proc_entry("android_touch") failed as well and the
+	 * directory leaked - every later probe then died in nvt_mp_proc_init().
+	 * Tear down the whole subtree instead.
+	 */
+	NVT_proc_selftest_entry = NULL;
+	if (NVT_proc_android_touch_entry != NULL) {
+		remove_proc_subtree("android_touch", NULL);
+		NVT_proc_android_touch_entry = NULL;
+		NVT_LOG("Removed /proc/android_touch\n");
+	}
+}
