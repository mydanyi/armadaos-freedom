+static int32_t nvt_ts_platform_probe(struct platform_device *pdev)
+{
+	int32_t ret = 0;
+
+	NVT_LOG("start\n");
+
+	pdev->dev.type = &tp_dev_type;
+
+	NVT_LOG("end\n");
+
+	return ret;
+}
