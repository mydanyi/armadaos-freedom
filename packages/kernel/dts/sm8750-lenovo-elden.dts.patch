From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: sm8750-lenovo-elden: adapt TB322FC board to runtime RAM and framebuffer handoff

diff --git a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
--- a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
@@ -18,6 +18,7 @@
 #include "pmih0108.dtsi"
 #include "pmk8550.dtsi"
 #include "sm8750-pmics.dtsi"
+#include "sm8750-lenovo-elden-camera.dtsi"
 
 / {
 	model = "Lenovo Legion Y700 Gen4";
@@ -573,36 +574,12 @@
 		#size-cells = <2>;
 		ranges;
 
-		framebuffer: framebuffer@fc800000 {
+		framebuffer: framebuffer {
 			compatible = "simple-framebuffer";
-			reg = <0x0 0xfc800000 0x0 0x2b00000>;
-			width = <1904>;
-			height = <3040>;
-			stride = <(1904 * 4)>;
-			format = "a8r8g8b8";
+			status = "disabled";
 		};
 	};
 
-	/* Exact bootloader-populated RAM map captured from the working tablet. */
-	memory@a0000000 {
-		device_type = "memory";
-		reg = <0x0 0x81960000 0x0 0xa0000>,
-		      <0x0 0x81a40000 0x0 0x1c0000>,
-		      <0x0 0x81cf4000 0x0 0xc000>,
-		      <0x0 0x82460000 0x0 0x40000>,
-		      <0x0 0xd8600000 0x0 0x0>,
-		      <0x0 0xe3720000 0x0 0x1c0e0000>,
-		      <0x8 0x80000000 0x0 0x2f700000>,
-		      <0x8 0xb0000000 0x0 0x5500000>,
-		      <0xa 0x0 0x2 0x0>,
-		      <0x8 0xc0000000 0x1 0x40000000>,
-		      <0x0 0x82800000 0x0 0x2200000>,
-		      <0x0 0x89d80000 0x0 0x1c80000>,
-		      <0x0 0xa2880000 0x0 0x15780000>,
-		      <0x0 0xb81c0000 0x0 0x1cc63000>,
-		      <0x0 0xd5100000 0x0 0x2f00000>;
-	};
-
 	clocks {
 		xo_board: xo-board {
 			compatible = "fixed-clock";
@@ -830,6 +807,7 @@
 			console-size = <0x200000>;
 			pmsg-size = <0x200000>;
 			no-map;
+			status = "disabled";
 		};
 
 		/*
@@ -839,6 +817,7 @@
 		splash_mem: splash-region@fc800000 {
 			reg = <0 0xfc800000 0 0x2b00000>;
 			no-map;
+			status = "disabled";
 		};
 	};
 
@@ -1692,7 +1671,6 @@
 };
 
 &mdss {
-	memory-region = <&splash_mem>;
 	/delete-property/ iommus;
 	status = "okay";
 };
@@ -2371,13 +2349,12 @@
 
 	status = "okay";
 
-	/* WCN7861 Peach/Brahma v2 uses the WCN7850 UART protocol. */
+	/* WCN7861 Peach/Brahma v2. */
 	bluetooth {
 		compatible = "qcom,wcn7861-bt";
 
-		firmware-name = "brhbtnv20.bin", "brhbtfw20.tlv";
-		/* Android-assigned public address, stored little-endian in DT. */
-		local-bd-address = [58 97 9c 62 22 22];
+		/* Keep the TB322FC NVM separate from other boards. */
+		firmware-name = "lenovo/tb322fc/brhbtnv20.bin", "brhbtfw20.tlv";
 
 		vddrfacmn-supply = <&vreg_wlan_pmu_rfa_cmn>;
 		vddaon-supply = <&vreg_wlan_pmu_aon_0p59>;
