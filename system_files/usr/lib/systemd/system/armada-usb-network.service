[Unit]
Description=Armada USB network link (NCM)
Documentation=file:///usr/libexec/armada/usb-network
After=sys-kernel-config.mount systemd-modules-load.service NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Only on devices whose profile sets ARMADA_USB_NETWORK=1, and never while USB file
# transfer owns the controller (its gadget carries the link then).
ExecCondition=/usr/libexec/armada/usb-network enabled
ExecCondition=/usr/bin/bash -c '! systemctl is-active --quiet armada-mtp.service'
ExecStart=/usr/libexec/armada/usb-network start
ExecStartPost=/usr/libexec/armada/usb-network ssh-resume
ExecStop=/usr/libexec/armada/usb-network stop

[Install]
WantedBy=multi-user.target
