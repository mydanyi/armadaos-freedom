[Unit]
Description=Armada USB network link (NCM)
Documentation=file:///usr/libexec/armada/usb-network
After=sys-kernel-config.mount systemd-modules-load.service NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Only where the device profile allows it and the Freedom Control switch is on, and
# never while USB file transfer owns the controller (its gadget carries the link then).
ExecCondition=/usr/libexec/armada/usb-network enabled
ExecCondition=/usr/bin/test ! -e /sys/kernel/config/usb_gadget/armada-mtp
ExecStart=/usr/libexec/armada/usb-network start
ExecStartPost=/usr/libexec/armada/usb-network ssh-resume
ExecStopPost=/usr/libexec/armada/usb-network stop

[Install]
WantedBy=multi-user.target
